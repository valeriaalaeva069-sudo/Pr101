default_platform(:android)

platform :android do
  # ============================================================
  # ИЗ ПР 10 — НЕ ТРОГАЕМ (Firebase App Distribution для тестировщиков)
  # ============================================================
  desc "Deploy to Firebase App Distribution"
  lane :distribute do
    firebase_app_distribution(
      # App ID из Firebase Console (Project settings -> Your apps)
      app: "1:936446383665:android:b195d667b79f33a76ee710",
      service_credentials_json_data: ENV["FIREBASE_SERVICE_ACCOUNT"],
      android_artifact_type: "APK",
      android_artifact_path: "app/build/outputs/apk/release/app-release.apk",
      groups: "qa-team",
      release_notes: "Сборка из GitHub Actions, коммит #{ENV['GITHUB_SHA']}"
    )
  end

  # ============================================================
  # ПР 11 — Шаг 2.2: загрузка AAB в Google Play Internal Testing
  # ============================================================
  desc "Upload AAB to Google Play Internal Testing"
  lane :internal do
    upload_to_play_store(
      package_name: "com.example.pr10",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      track: "internal",
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # ============================================================
  # ПР 11 — Шаг 2.2: продвижение Internal -> Production
  # ============================================================
  desc "Promote release from internal to production"
  lane :promote_prod do
    upload_to_play_store(
      package_name: "com.example.pr10",
      track: "internal",
      track_promote_to: "production",
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # ============================================================
  # ПР 11 — Шаг 3.1: HALT production rollout (rollback)
  # Запускается вручную, если Crashlytics показал crashrate >= 50%
  # ============================================================
  desc "Halt production rollout (rollback)"
  lane :halt_prod do
    upload_to_play_store(
      package_name: "com.example.pr10",
      track: "production",
      rollout: 0.0,
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end